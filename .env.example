# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Helpdesk API (address and key are in Nordavo's email)
HELPDESK_BASE_URL=https://nakywgkztvzkihdjnwbc.supabase.co/functions/v1/helpdesk
HELPDESK_API_KEY=nrd_round_replace_me
# The address you applied with. Always the same one: it identifies your account.
CANDIDATE_EMAIL=you@example.com
CANDIDATE_NAME=

# Model provider: groq (free tier) or anthropic
LLM_PROVIDER=groq
# Empty = provider default (groq: openai/gpt-oss-120b, anthropic: claude-haiku-5-5)
LLM_MODEL=
LLM_EFFORT=low
GROQ_API_KEY=gsk_replace_me
ANTHROPIC_API_KEY=
# Groq free tier: about 30 requests and 8,000 tokens per minute
MODEL_REQUESTS_PER_MINUTE=25
# Optional overrides of the list price used in the cost report (USD per million tokens)
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=

# Agent behaviour
CONFIDENCE_THRESHOLD=0.75
REQUESTS_PER_SECOND=4
MAX_RUN_COST_USD=0.50
MAX_TICKETS_PER_RUN=200
